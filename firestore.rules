rules_version = '2';

// Each player can only read and write their own progress document: users/{uid}.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Mirrors the fields pushed by js/cloud.js.
    function validProgress(d) {
      return d.keys().hasOnly(['level', 'maxLevel', 'muted', 'vibration', 'showMoves',
                               'theme', 'progressAt', 'settingsAt', 'updatedAt'])
        && d.level is int && d.level >= 1 && d.level <= 999
        && d.maxLevel is int && d.maxLevel >= 1 && d.maxLevel <= 999
        && d.muted is bool && d.vibration is bool && d.showMoves is bool
        && d.theme in ['auto', 'light', 'dark']
        && d.progressAt is number && d.settingsAt is number
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProgress(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
